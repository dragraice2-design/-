:root { color-scheme: light; }
.spiral-shell { margin: 0; overflow-x: hidden; background: #eef2ff; }
.spiral-app {
  --primary: #4f46e5; --primary-dark: #3730a3; --secondary: #818cf8;
  --accent: #ea580c; --ink: #1e1b4b; --muted: #526077; --line: #c7d2fe;
  --surface: #ffffff; --soft: #f7f8ff; --success: #15803d; --danger: #b91c1c;
  width: 100%; min-width: 0; max-width: 1480px; margin: 0 auto; padding: 24px; overflow-x: clip; color: var(--ink);
  font-family: ui-rounded, "Segoe UI", system-ui, -apple-system, sans-serif;
  font-size: 16px; line-height: 1.5;
}
.spiral-app, .spiral-app *, .spiral-app *::before, .spiral-app *::after { box-sizing: border-box; }
.spiral-app button, .spiral-app input, .spiral-app select { font: inherit; }
.spiral-app button { cursor: pointer; }
.hero { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 20px; align-items: center; margin-bottom: 24px; }
.brand-mark { width: 64px; height: 64px; display: grid; place-items: center; color: var(--primary); background: #fff; border: 2px solid var(--line); border-radius: 22px; box-shadow: 0 10px 0 #dfe4ff; }
.brand-mark svg { width: 44px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; }
.brand-mark svg circle { fill: #ffedd5; stroke: var(--accent); }
.eyebrow { margin: 0 0 4px; color: var(--primary); font-size: .76rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
.hero h1 { margin: 0; font-size: clamp(2rem, 5vw, 3.6rem); line-height: 1; letter-spacing: -.045em; }
.hero-copy { max-width: 780px; margin: 10px 0 0; color: var(--muted); }
.model-badge, .status-pill, .result-badge { display: inline-flex; align-items: center; gap: 8px; border-radius: 999px; font-weight: 700; white-space: nowrap; }
.model-badge { padding: 10px 14px; background: #fff; border: 1px solid var(--line); font-size: .82rem; }
.pulse-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--success); box-shadow: 0 0 0 5px #dcfce7; }
.workspace { display: grid; grid-template-columns: minmax(300px, 360px) minmax(0, 1fr); gap: 20px; align-items: start; }
.mission-column { min-width: 0; display: grid; gap: 20px; }
.card { background: var(--surface); border: 2px solid var(--line); border-radius: 24px; box-shadow: 0 10px 0 #dfe4ff; }
.control-panel { padding: 20px; position: sticky; top: 16px; }
.section-heading, .result-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
.section-heading > div, .result-top > div { display: flex; align-items: center; gap: 10px; }
.section-heading h2, .result-top h2 { margin: 0; font-size: 1.08rem; }
.section-heading.compact { padding: 18px 20px 12px; align-items: center; }
.step { color: var(--primary); font-size: .75rem; font-weight: 900; letter-spacing: .08em; }
.text-button { min-height: 44px; padding: 6px 4px; border: 0; color: var(--primary); background: transparent; font-size: .8rem; font-weight: 800; }
.text-button:hover { text-decoration: underline; }
fieldset { margin: 18px 0 0; padding: 16px 0 0; border: 0; border-top: 1px solid #e4e7f8; }
legend { padding: 0 8px 0 0; color: var(--muted); font-size: .78rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
.field-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.field { min-width: 0; display: grid; gap: 6px; color: #37345f; font-size: .8rem; font-weight: 700; }
.field input, .field select { width: 100%; min-height: 46px; padding: 9px 11px; color: var(--ink); background: var(--soft); border: 1px solid #b9c2ee; border-radius: 12px; outline: none; }
.field input:hover, .field select:hover { border-color: var(--secondary); }
.field input:focus-visible, .field select:focus-visible, button:focus-visible, summary:focus-visible { outline: 3px solid #fb923c; outline-offset: 2px; }
.range-field { margin-bottom: 14px; }
.range-field > span { display: flex; justify-content: space-between; align-items: center; }
.range-field output { color: var(--primary); font-weight: 900; }
.range-field input { min-height: 30px; padding: 0; accent-color: var(--primary); }
.field small, .switch-row small { display: block; color: var(--muted); font-weight: 500; line-height: 1.35; }
.switch-row { display: grid; grid-template-columns: 42px minmax(0, 1fr); gap: 10px; align-items: center; margin-top: 14px; cursor: pointer; }
.switch-row > input { position: absolute; opacity: 0; pointer-events: none; }
.switch { grid-column: 1; width: 42px; height: 24px; padding: 3px; border-radius: 999px; background: #a9b3ca; transition: background .2s ease; }
.switch-row > span:last-child { grid-column: 2; }
.switch::after { content: ""; display: block; width: 18px; height: 18px; border-radius: 50%; background: #fff; box-shadow: 0 1px 4px #0004; transition: transform .2s ease; }
.switch-row input:checked + .switch { background: var(--primary); }
.switch-row input:checked + .switch::after { transform: translateX(18px); }
.switch-row input:focus-visible + .switch { outline: 3px solid #fb923c; outline-offset: 2px; }
.form-error { margin-top: 14px; padding: 10px 12px; color: #7f1d1d; background: #fef2f2; border: 1px solid #fecaca; border-radius: 12px; font-size: .84rem; }
.action-row { display: grid; grid-template-columns: 1fr auto; gap: 10px; margin-top: 18px; }
.primary-button, .secondary-button { min-height: 50px; padding: 10px 16px; border-radius: 14px; border: 2px solid; font-weight: 900; transition: background .18s ease, box-shadow .18s ease, opacity .18s ease; }
.primary-button { color: #fff; background: var(--primary); border-color: var(--primary-dark); box-shadow: 0 5px 0 var(--primary-dark); }
.primary-button:hover { background: #4338ca; }
.secondary-button { color: var(--ink); background: #fff; border-color: var(--line); box-shadow: 0 5px 0 #d8def9; }
.primary-button:active, .secondary-button:active { box-shadow: none; }
button:disabled { cursor: not-allowed; opacity: .48; box-shadow: none; }
.metrics { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
.metric-card { min-width: 0; padding: 14px 16px; background: #fff; border: 1px solid var(--line); border-radius: 18px; box-shadow: 0 5px 0 #dfe4ff; }
.metric-card span, .metric-card small { display: block; color: var(--muted); font-size: .75rem; }
.metric-card strong { display: block; margin: 4px 0 2px; overflow: hidden; font-size: clamp(1rem, 2vw, 1.35rem); text-overflow: ellipsis; white-space: nowrap; }
.status-pill { padding: 7px 11px; color: #37345f; background: #eef2ff; font-size: .78rem; }
.status-pill.running { color: #166534; background: #dcfce7; }
.status-pill.paused { color: #9a3412; background: #ffedd5; }
.canvas-wrap { position: relative; width: 100%; overflow: hidden; }
.orbit-wrap { min-height: 440px; border-radius: 0 0 22px 22px; background: radial-gradient(circle at 50% 50%, #202968 0, #11143b 45%, #07091f 100%); }
.orbit-wrap canvas { display: block; width: 100%; height: min(56vw, 580px); min-height: 440px; }
.orbit-legend { position: absolute; left: 16px; bottom: 14px; display: flex; flex-wrap: wrap; gap: 12px; padding: 7px 10px; color: #eef2ff; background: #07091fcc; border: 1px solid #ffffff2b; border-radius: 10px; font-size: .72rem; }
.orbit-legend span { display: flex; align-items: center; gap: 6px; }
.legend-line { width: 24px; border-top: 2px solid #93c5fd; }
.legend-line.target { border-top-style: dashed; border-color: #fb923c; }
.legend-arrow { width: 22px; border-top: 2px solid #f97316; position: relative; }
.legend-arrow::after { content: ""; position: absolute; right: -1px; top: -4px; border: 3px solid transparent; border-left-color: #f97316; }
.trend-text { max-width: 55%; margin: 0; color: var(--muted); font-size: .8rem; text-align: right; }
.chart-wrap { height: 310px; padding: 0 8px 8px; }
.chart-wrap canvas { display: block; width: 100%; height: 100%; }
.result-card { padding: 20px; }
.result-badge { padding: 8px 12px; font-size: .78rem; }
.result-badge.neutral { color: #475569; background: #f1f5f9; }
.result-badge.success { color: #166534; background: #dcfce7; }
.result-badge.failure { color: #991b1b; background: #fee2e2; }
#resultSummary { color: var(--muted); }
.criteria-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
.criterion { display: grid; grid-template-columns: 28px 1fr; gap: 10px; padding: 12px; border: 1px solid #e1e5f6; border-radius: 14px; }
.criterion > span { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 50%; font-weight: 900; }
.criterion strong, .criterion small { display: block; }
.criterion small { color: var(--muted); }
.criterion.pass > span { color: #fff; background: var(--success); }
.criterion.fail > span { color: #fff; background: var(--danger); }
.criterion.pending > span { color: #475569; background: #e2e8f0; }
details { margin-top: 14px; padding-top: 12px; border-top: 1px solid #e4e7f8; color: var(--muted); }
